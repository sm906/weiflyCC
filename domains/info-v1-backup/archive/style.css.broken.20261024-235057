body{
margin:0;
background:#050816;
color:#fff;
font-family:"Noto Sans TC",sans-serif;
}

.container{
max-width:1200px;
margin:auto;
padding:0 20px;
}

.hero{
min-height:100vh;
display:flex;
align-items:center;
justify-content:center;
text-align:center;
background:
linear-gradient(
135deg,
#050816,
#081423,
#050816
);
}

.hero-logo{
width:180px;
height:180px;
border-radius:50%;
object-fit:cover;
border:3px solid #3b82f6;
}

.hero h1{
font-size:4rem;
margin:20px 0;
}

.hero h2{
color:#93c5fd;
}

.btn-primary{
display:inline-block;
background:#2563eb;
padding:14px 24px;
border-radius:999px;
color:#fff;
text-decoration:none;
}

.grid{
display:grid;
grid-template-columns:
repeat(auto-fit,minmax(250px,1fr));
gap:20px;
margin-top:40px;
}

.card{
background:#0f172a;
padding:24px;
border-radius:20px;
border:1px solid rgba(255,255,255,.08);
}

.gallery{
display:grid;
grid-template-columns:
repeat(auto-fit,minmax(300px,1fr));
gap:24px;
}

.case-card{
background:#0f172a;
overflow:hidden;
border-radius:20px;
color:#fff;
text-decoration:none;
}

.case-card img{
width:100%;
height:240px;
object-fit:cover;
}

.case-content{
padding:20px;
}

#cc02{
position:fixed;
right:20px;
bottom:20px;
width:90px;
height:90px;
z-index:99999;
cursor:pointer;
}

#cc02 img{
width:100%;
height:100%;
object-fit:contain;
}

#bubble{
display:none;
position:fixed;
background:#111827;
color:#fff;
padding:10px 16px;
border-radius:16px;
border:1px solid #3b82f6;
z-index:100000;
}

@media(max-width:768px){

.hero-logo{
width:120px;
height:120px;
}

.hero h1{
font-size:2.5rem;
}

#cc02{
width:70px;
height:70px;
}

}
